# Original (heavy) photos stay on this computer only.
# The website uses the compressed copies in assets/ (generated by tools/build.js).
content/**/*.jpg
content/**/*.jpeg
content/**/*.png
content/**/*.webp
content/**/*.tif
content/**/*.tiff
content/**/*.bmp
content/**/*.heic
content/**/*.gif
content/**/*.pdf
